generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  name         String
  phone        String
  email        String
  address      String
  deliveryType String
  items        Json
  subtotal     Float
  deliveryFee  Float
  total        Float
  status       String   @default("pending")
  paymentId    String?
  pfPaymentId  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  soldOut   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
